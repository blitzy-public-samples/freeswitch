<document type="freeswitch/xml"><section name="dialplan"><context name="default"><extension name="global" continue="true"><condition field="call_debug" expression="^true$" break="never"><action application="info"/><action application="log" data="INFO channel debug is enabled"/><action application="set" data="call_debug_logged=true"/></condition><condition field="default_password" expression="^1234$" break="never"><action application="log" data="CRIT Open vars.xml and change the default_password."/><action application="log" data="CRIT Once changed type 'reloadxml' at the console."/><action application="sleep" data="10000"/></condition><condition field="rtp_has_crypto" expression="^(AES_CM_128_HMAC_SHA1_32|AES_CM_128_HMAC_SHA1_80)$" break="never"><action application="set" data="rtp_secure_media=true"/><action application="export" data="rtp_secure_media=true"/><action application="log" data="INFO offering srtp on the outbound leg"/></condition></extension><extension name="tod_holiday" continue="true"><condition wday="2-6" hour="9-18" break="never"><action application="set" data="open=true"/><action application="set" data="business_hours=weekday"/><action application="log" data="INFO weekday business hours"/></condition><condition wday="7" hour="10-14" break="never"><action application="set" data="open=true"/><action application="set" data="business_hours=saturday"/><action application="log" data="INFO saturday business hours"/></condition><condition mday="25" mon="12" break="never"><action application="set" data="open=false"/><action application="set" data="business_hours=holiday"/><action application="log" data="INFO christmas day closure"/></condition></extension><extension name="features" continue="true"><condition field="record_stereo" expression="^true$" break="never"><action application="set" data="record_stereo=true"/><action application="set" data="RECORD_STEREO=true"/><action application="log" data="INFO stereo recording enabled"/></condition><condition field="sip_via_protocol" expression="^(tls|wss)$" break="never"><action application="set" data="sip_secure_media=true"/><action application="export" data="sip_secure_media=true"/><action application="log" data="INFO signalling arrived over tls"/></condition><condition field="accountcode" expression="^(\d{4})$" break="never"><action application="set" data="accountcode=$1"/><action application="export" data="accountcode=$1"/><action application="log" data="INFO billing account tagged"/></condition></extension></context></section></document>
