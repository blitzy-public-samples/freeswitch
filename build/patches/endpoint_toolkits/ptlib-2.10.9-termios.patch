 #include <signal.h>
 
 #if (defined(P_LINUX) && defined(__GLIBC_)) || defined(P_SOLARIS)
-#include <termio.h>
+#include <termios.h>  /* glibc >= 2.42 removed <termio.h> */
 #endif
 
